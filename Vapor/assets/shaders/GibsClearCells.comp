#version 460
// GIBS spatial hash pass 1 — GLSL twin of gibs_spatial_hash.metal's
// `clearCellHeads`: reset every cell's linked-list head.
#extension GL_GOOGLE_include_directive : require
#include "include/gibs_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer CellHeadBuf { uint cellHeads[]; };
layout(std430, set = 0, binding = 1) readonly buffer GIBSBuf { GIBSData gibs; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid < gibs.totalCells) {
        cellHeads[gid] = GIBS_INVALID_INDEX;
    }
}
