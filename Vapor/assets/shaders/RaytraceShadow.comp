#version 460
// Ray-traced near-field directional (sun) shadow — GLSL ray-query twin of
// 3d_raytrace_shadow.metal. One occlusion ray per pixel (angularRadius == 0),
// or `samples` cone-jittered rays for a true RT penumbra. Writes visibility
// into the half-res shadowRT; the PBR pass samples it (mipped) for the near
// region and blends to the PSSM cascades beyond the split.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "include/rt_common.glsl"

// Metal dispatches (w, h) groups of 1x1 threads; keep the same grid semantics.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform sampler2D depthTexture;   // full-res
layout(set = 2, binding = 1) uniform sampler2D normalTexture;  // full-res
layout(set = 1, binding = 2) uniform writeonly image2D shadowTexture;

layout(std430, set = 0, binding = 0) readonly buffer CameraBuf { CameraData camera; };
layout(std430, set = 0, binding = 1) readonly buffer DirLightBuf { DirLight directionalLights[]; };
layout(std430, set = 0, binding = 2) readonly buffer PointLightBuf { PointLight pointLights[]; };

layout(set = 3, binding = 4) uniform accelerationStructureEXT TLAS;

// setComputeBytes slots 3 (screenSize) + 5 (SunShadowParams): offsets 48 / 80.
layout(push_constant) uniform PC {
    layout(offset = 48) vec2 screenSize;
    layout(offset = 80) float sunAngularRadius;  // radians; 0 = hard shadow
    layout(offset = 84) uint sunFrameIndex;
    layout(offset = 88) uint sunSampleCount;     // rays per pixel when > 0
};

bool occlusionRayHit(vec3 origin, vec3 dir, float tMin, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, TLAS,
                          gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                          0xFF, origin, tMin, dir, tMax);
    rayQueryProceedEXT(rq);
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    ivec2 outDim = imageSize(shadowTexture);
    if (tid.x >= uint(outDim.x) || tid.y >= uint(outDim.y)) return;

    // Resolution-agnostic: depth/normal may be higher-res than the shadow target.
    ivec2 fullDim = textureSize(depthTexture, 0);
    uvec2 scale = max(uvec2(fullDim) / uvec2(outDim), uvec2(1u));
    ivec2 fullTid = ivec2(min(tid * scale, uvec2(fullDim) - 1u));

    vec2 uv = (vec2(tid) + 0.5) / vec2(outDim);
    float depth = texelFetch(depthTexture, fullTid, 0).r;
    vec3 worldPos = worldPosFromDepth(uv, depth, camera.invProj, camera.invView);
    vec3 worldNormal = normalize(texelFetch(normalTexture, fullTid, 0).xyz);

    DirLight light = directionalLights[0];

    // Cone-sampled sun soft shadows: angularRadius == 0 collapses to one ray
    // along the sun direction (bit-for-bit the hard shadow); > 0 jitters each
    // ray within the sun's disk and averages.
    vec3 sunDir = normalize(-light.direction);
    uint sampleCount = (sunAngularRadius > 0.0) ? max(sunSampleCount, 1u) : 1u;
    vec3 up = abs(sunDir.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t1 = normalize(cross(up, sunDir));
    vec3 t2 = cross(sunDir, t1);
    float tanRadius = tan(sunAngularRadius);
    float visibility = 0.0;
    for (uint s = 0u; s < sampleCount; s++) {
        vec3 dir = sunDir;
        if (sunAngularRadius > 0.0) {
            uint seed = tid.x * 1973u + tid.y * 9277u
                      + sunFrameIndex * 26699u + s * 6151u;
            vec2 rnd = rand2(seed);
            float rr = sqrt(rnd.x) * tanRadius;
            float phi = rnd.y * 2.0 * PI;
            dir = normalize(sunDir + t1 * (rr * cos(phi)) + t2 * (rr * sin(phi)));
        }
        vec3 origin = worldPos + worldNormal * 0.005;
        visibility += occlusionRayHit(origin, dir, 0.001, 10000.0) ? 0.0 : 1.0;
    }
    visibility /= float(sampleCount);
    imageStore(shadowTexture, ivec2(tid), vec4(visibility, visibility, visibility, 1.0));
}
