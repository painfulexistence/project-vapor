#version 460
// ReSTIR stochastic-shadow pass 2: spatial reuse + winner visibility rays —
// GLSL ray-query twin of 3d_restir_shadow_resolve.metal. Merges a few
// geometry-compatible neighbor reservoirs into the pixel's own (biased
// combiner under depth/normal guards), traces the merged winner's visibility,
// and writes R/G/B = point/rect/spot visibility to the HALF-RES raw target.
// The post-spatial reservoirs become next frame's temporal history. See the
// Metal kernel for the rect R2 quad-walk rationale.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "include/rt_common.glsl"
#include "include/restir_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform sampler2D depthTexture;
layout(set = 2, binding = 1) uniform sampler2D normalTexture;
layout(set = 1, binding = 2) uniform writeonly image2D shadowTexture;

layout(std430, set = 0, binding = 0) readonly buffer CameraBuf { CameraData camera; };
layout(std430, set = 0, binding = 1) readonly buffer PointLightBuf { PointLight pointLights[]; };
layout(std430, set = 0, binding = 2) readonly buffer ClusterBuf { Cluster clusters[]; };
layout(std430, set = 0, binding = 3) readonly buffer SpotLightBuf { SpotLight spotLights[]; };
layout(std430, set = 0, binding = 4) readonly buffer RectLightBuf { RectLight rectLights[]; };
layout(std430, set = 0, binding = 5) readonly buffer InBuf { ShadowReservoirSet inReservoirs[]; };
layout(std430, set = 0, binding = 6) buffer HistoryBuf { ShadowReservoirSet history[]; };
layout(set = 3, binding = 7) uniform accelerationStructureEXT TLAS;
layout(std430, set = 0, binding = 8) readonly buffer ParamsBuf { RestirShadowParams params; };

// Plastic-constant (R2) low-discrepancy increment for the rect quad walk.
const vec2 kR2 = vec2(0.7548776662, 0.5698402910);

float traceVisibility(vec3 origin, vec3 normal, vec3 target) {
    vec3 toL = target - origin;
    float dist = length(toL);
    if (dist <= 0.01) return 1.0;
    vec3 dir = toL / dist;
    if (dot(dir, normal) <= 0.0) return 1.0;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, TLAS,
                          gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                          0xFF, origin + normal * 0.005, 0.001, dir, dist - 0.01);
    rayQueryProceedEXT(rq);
    return (rayQueryGetIntersectionTypeEXT(rq, true) ==
            gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
}

void main() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    uint w = uint(params.screenSize.x);
    uint h = uint(params.screenSize.y);
    uint halfW = (w + 1u) / 2u;
    uint halfH = (h + 1u) / 2u;
    if (tid.x >= halfW || tid.y >= halfH) return;
    uint pixel = tid.y * halfW + tid.x;
    uvec2 fp = tid * 2u;  // representative full-res pixel of this half texel

    float depth = texelFetch(depthTexture, ivec2(fp), 0).r;
    if (depth >= 1.0) {
        imageStore(shadowTexture, ivec2(tid), vec4(params.debugMode == 1u ? 0.0 : 1.0));
        history[pixel] = restirEmptySet(0.0);
        return;
    }

    RestirSurface surf = restirReconstructSurface(fp, w, h, depth, camera);
    vec3 worldNormal = normalize(texelFetch(normalTexture, ivec2(fp), 0).xyz);

    ShadowReservoirSet own = inReservoirs[pixel];

    // Tile heatmap debug (parity with the legacy kernel's debugMode 1).
    if (params.debugMode == 1u) {
        vec2 uv = vec2(fp) / vec2(w, h);
        uint lightCount = clusters[restirClusterIndex(uv, params.gridDims)].lightCount;
        imageStore(shadowTexture, ivec2(tid), vec4(float(lightCount) / 8.0));
        history[pixel] = own; // keep reservoir state flowing
        return;
    }

    uint rng = tid.x * 2371u + tid.y * 8933u + params.frameIndex * 15881u;

    // Rebuild working reservoirs from the stored (sample, W, M) form:
    // wSum = W * M * p̂(y) with p̂ evaluated here (same pixel, same frame).
    WRSReservoir rPoint = wrsEmpty();
    {
        uint idx = restirUnpackIdx(own.pointData);
        if (idx < params.pointCount && own.pointW > 0.0 && isFiniteF(own.pointW)) {
            float pdf = restirPointPdf(pointLights[idx], surf.worldPos, worldNormal);
            rPoint.candidate = idx;
            rPoint.pdf = pdf;
            rPoint.wSum = own.pointW * restirUnpackM(own.pointData) * pdf;
        }
        rPoint.M = restirUnpackM(own.pointData);
    }
    WRSReservoir rRect = wrsEmpty();
    {
        uint idx = restirUnpackIdx(own.rectData);
        if (idx < params.rectCount && own.rectW > 0.0 && isFiniteF(own.rectW)) {
            vec2 quadUV = vec2(randomNext(rng), randomNext(rng));
            float pdf = restirRectPdf(rectLights[idx], quadUV, surf.worldPos, worldNormal);
            rRect.candidate = idx;
            rRect.pdf = pdf;
            rRect.wSum = own.rectW * restirUnpackM(own.rectData) * pdf;
        }
        rRect.M = restirUnpackM(own.rectData);
    }
    WRSReservoir rSpot = wrsEmpty();
    {
        uint idx = restirUnpackIdx(own.spotData);
        if (idx < params.spotCount && own.spotW > 0.0 && isFiniteF(own.spotW)) {
            float pdf = restirSpotPdf(spotLights[idx], surf.worldPos, worldNormal);
            rSpot.candidate = idx;
            rSpot.pdf = pdf;
            rSpot.wSum = own.spotW * restirUnpackM(own.spotData) * pdf;
        }
        rSpot.M = restirUnpackM(own.spotData);
    }

    // ---- Spatial reuse ------------------------------------------------------
    // Tap offsets are in HALF-res pixels; the CPU pre-scales spatialRadius.
    float angle = randomNext(rng) * 2.0 * PI;
    mat2 rot = mat2(vec2(cos(angle), sin(angle)),
                    vec2(-sin(angle), cos(angle)));
    for (uint t = 0u; t < params.spatialTaps; t++) {
        vec2 offset = rot * poissonDisk8[t % 8u] * params.spatialRadius;
        ivec2 nb = ivec2(vec2(tid) + offset + 0.5);
        if (nb.x < 0 || nb.y < 0 || nb.x >= int(halfW) || nb.y >= int(halfH)) continue;
        if (uint(nb.x) == tid.x && uint(nb.y) == tid.y) continue;

        ShadowReservoirSet nbSet = inReservoirs[uint(nb.y) * halfW + uint(nb.x)];
        // Geometry compatibility: same-ish depth (sky neighbors carry 0) and
        // same-ish orientation, else the reused W darkens across silhouettes.
        if (nbSet.viewDepth == 0.0 ||
            abs(nbSet.viewDepth - surf.viewDepth) > params.depthTolerance * abs(surf.viewDepth)) continue;
        if (dot(restirUnpackNormal(nbSet.packedNormal), worldNormal) < params.normalTolerance) continue;

        uint idx = restirUnpackIdx(nbSet.pointData);
        if (idx < params.pointCount && nbSet.pointW > 0.0 && isFiniteF(nbSet.pointW)) {
            float pdf = restirPointPdf(pointLights[idx], surf.worldPos, worldNormal);
            wrsMerge(rPoint, idx, pdf, nbSet.pointW, restirUnpackM(nbSet.pointData), randomNext(rng));
        }
        idx = restirUnpackIdx(nbSet.rectData);
        if (idx < params.rectCount && nbSet.rectW > 0.0 && isFiniteF(nbSet.rectW)) {
            vec2 quadUV = vec2(randomNext(rng), randomNext(rng));
            float pdf = restirRectPdf(rectLights[idx], quadUV, surf.worldPos, worldNormal);
            wrsMerge(rRect, idx, pdf, nbSet.rectW, restirUnpackM(nbSet.rectData), randomNext(rng));
        }
        idx = restirUnpackIdx(nbSet.spotData);
        if (idx < params.spotCount && nbSet.spotW > 0.0 && isFiniteF(nbSet.spotW)) {
            float pdf = restirSpotPdf(spotLights[idx], surf.worldPos, worldNormal);
            wrsMerge(rSpot, idx, pdf, nbSet.spotW, restirUnpackM(nbSet.spotData), randomNext(rng));
        }
    }

    // ---- Store post-spatial reservoirs as next frame's history --------------
    history[pixel] = restirPackSet(rPoint, rRect, rSpot, surf.viewDepth, worldNormal);

    // Debug views need only the merged reservoirs — return before spending rays.
    if (params.debugMode == 2u) {
        vec3 ids = vec3(
            rPoint.pdf > 0.0 ? (float(rPoint.candidate % 8u) + 1.0) / 9.0 : 0.0,
            rRect.pdf > 0.0 ? (float(rRect.candidate % 8u) + 1.0) / 9.0 : 0.0,
            rSpot.pdf > 0.0 ? (float(rSpot.candidate % 8u) + 1.0) / 9.0 : 0.0);
        imageStore(shadowTexture, ivec2(tid), vec4(ids, 1.0));
        return;
    }
    if (params.debugMode == 3u) {
        vec3 ms = vec3(rPoint.M / max(params.pointMClamp * 2.0, 1.0),
                       rRect.M / max(params.rectMClamp * 2.0, 1.0),
                       rSpot.M / max(params.spotMClamp * 2.0, 1.0));
        imageStore(shadowTexture, ivec2(tid), vec4(clamp(ms, 0.0, 1.0), 1.0));
        return;
    }

    // ---- Winner visibility (one ray per domain) -----------------------------
    float pointVis = 1.0;
    if (rPoint.pdf > 0.0) {
        pointVis = traceVisibility(surf.worldPos, worldNormal,
                                   pointLights[rPoint.candidate].position);
    }
    float rectVis = 1.0;
    if (rRect.pdf > 0.0) {
        // Two quad points per frame, stratified in space AND time (per-pixel
        // Cranley-Patterson rotation + phase-shifted R2 walk; second tap
        // antithetic). See the Metal twin for the full derivation.
        RectLight rl = rectLights[rRect.candidate];
        vec2 cp = rand2(tid.x * 9781u + tid.y * 6271u);
        uint phase = (tid.x * 113u + tid.y * 271u) & 1023u;
        vec2 uv0 = fract(cp + float((params.frameIndex + phase) & 1023u) * kR2);
        vec2 uv1 = fract(uv0 + 0.5);
        rectVis = 0.5 * (traceVisibility(surf.worldPos, worldNormal, restirRectPoint(rl, uv0)) +
                         traceVisibility(surf.worldPos, worldNormal, restirRectPoint(rl, uv1)));
    }
    float spotVis = 1.0;
    if (rSpot.pdf > 0.0) {
        spotVis = traceVisibility(surf.worldPos, worldNormal,
                                  spotLights[rSpot.candidate].position);
    }

    imageStore(shadowTexture, ivec2(tid), vec4(pointVis, rectVis, spotVis, 1.0));
}
