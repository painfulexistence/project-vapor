#version 460
// GIBS surfel raytracing — GLSL ray-query twin of gibs_raytracing.metal's
// `surfelRaytracing`. Per (staggered) surfel: one sun occlusion ray for direct
// light, then raysPerSurfel cosine-hemisphere bounce rays whose hits sample
// the surfel cache (one-bounce infinite feedback), temporally blended into the
// canonical surfel buffer.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "include/rt_common.glsl"
#include "include/gibs_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer SurfelBuf { Surfel surfels[]; };
layout(std430, set = 0, binding = 1) readonly buffer CellHeadBuf { uint cellHeads[]; };
layout(std430, set = 0, binding = 2) readonly buffer GIBSBuf { GIBSData gibs; };
layout(set = 3, binding = 4) uniform accelerationStructureEXT TLAS;
layout(std430, set = 0, binding = 5) readonly buffer SurfelNextBuf { uint surfelNext[]; };

// setComputeBytes slot 3 -> push offset 48 (SurfelRaytracingParams, 32 bytes).
layout(push_constant) uniform PC {
    layout(offset = 48) uint surfelOffset;
    layout(offset = 52) uint surfelCount;
    layout(offset = 56) uint raysPerSurfel;
    layout(offset = 60) uint frameIndex;
    layout(offset = 64) float rayBias;
    layout(offset = 68) float rayMaxDistance;
    layout(offset = 72) uint updateInterval;
    layout(offset = 76) uint _pcPad;
};

bool occlusionRayHit(vec3 origin, vec3 dir, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, TLAS,
                          gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                          0xFF, origin, 0.001, dir, tMax);
    rayQueryProceedEXT(rq);
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Simple Lambertian direct lighting with a sun shadow ray.
vec3 computeDirectLight(vec3 position, vec3 normal, vec3 albedo) {
    float shadow = occlusionRayHit(position + normal * 0.001, gibs.sunDirection, 10000.0)
                       ? 0.0 : 1.0;
    float NdotL = max(0.0, dot(normal, gibs.sunDirection));
    return albedo * gibs.sunColor * gibs.sunIntensity * NdotL * shadow * GIBS_INV_PI;
}

// Nearest-surfel radiance at a hit position via the cell linked list.
vec3 sampleSurfelAtPosition(vec3 hitPos, vec3 hitNormal) {
    if (!isInWorldBounds(hitPos, gibs.worldMin, gibs.worldMax)) {
        return vec3(0.0);
    }
    uint cellHash = computeCellHash(hitPos, gibs.worldMin, gibs.cellSize, gibs.gridSize);
    if (cellHash >= gibs.totalCells) {
        return vec3(0.0);
    }
    float bestWeight = 0.0;
    vec3 bestIrradiance = vec3(0.0);
    uint iter = 0u;
    for (uint j = cellHeads[cellHash];
         j != GIBS_INVALID_INDEX && iter < GIBS_MAX_CHAIN_LENGTH;
         j = surfelNext[j], iter++) {
        Surfel surfel = surfels[j];
        if ((surfel.flags & SURFEL_FLAG_VALID) == 0u) {
            continue;
        }
        float weight = computeSurfelWeight(hitPos, hitNormal, surfel, gibs.cellSize * 2.0);
        if (weight > bestWeight) {
            bestWeight = weight;
            bestIrradiance = surfel.irradiance + surfel.directLight;
        }
    }
    return bestIrradiance * bestWeight;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    // Staggered updates: each frame traces one residue class of surfel indices.
    uint interval = max(updateInterval, 1u);
    uint surfelIndex = surfelOffset + gid * interval + (frameIndex % interval);

    if (surfelIndex >= gibs.activeSurfelCount) {
        return;
    }

    Surfel surfel = surfels[surfelIndex];
    if ((surfel.flags & SURFEL_FLAG_VALID) == 0u) {
        return;
    }

    surfel.directLight = computeDirectLight(surfel.position, surfel.normal, surfel.albedo);

    // Accumulate indirect lighting from multiple rays.
    vec3 indirectSum = vec3(0.0);
    uint validRays = 0u;

    for (uint rayIndex = 0u; rayIndex < raysPerSurfel; rayIndex++) {
        uint seed = surfelIndex * 1000u + rayIndex + frameIndex * 100000u;
        vec2 u = randomFloat2(seed);
        vec3 rayDir = sampleCosineHemisphere(u, surfel.normal);
        vec3 origin = surfel.position + surfel.normal * rayBias;

        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, TLAS, gl_RayFlagsOpaqueEXT, 0xFF,
                              origin, 0.001, rayDir, rayMaxDistance);
        while (rayQueryProceedEXT(rq)) {}

        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            float hitT = rayQueryGetIntersectionTEXT(rq, true);
            vec3 hitPos = origin + rayDir * hitT;
            // Approximate hit normal (exact would need geometry data).
            vec3 hitNormal = -rayDir;
            vec3 hitRadiance = sampleSurfelAtPosition(hitPos, hitNormal);
            indirectSum += hitRadiance * surfel.albedo;
            validRays++;
        } else {
            // Hit sky — simplified environment term (matches the Metal kernel).
            vec3 skyColor = vec3(0.5, 0.7, 1.0) * 0.3;
            indirectSum += skyColor * surfel.albedo;
            validRays++;
        }
    }

    vec3 newIndirect = vec3(0.0);
    if (validRays > 0u) {
        newIndirect = indirectSum / float(validRays);
    }

    // Temporal blending with previous irradiance.
    surfel.irradiance = mix(surfel.irradiance, newIndirect, gibs.temporalBlend);
    surfel.age += 1.0;

    surfels[surfelIndex] = surfel;
}
