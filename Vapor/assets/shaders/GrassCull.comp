#version 450
// Grass ring — per-cell GPU frustum cull (Vulkan; MSL twin: grassCullKernel in
// 3d_grass.metal). One thread per resident grass cell: test the cell's world
// AABB against the camera frustum and write one NON-INDEXED indirect draw
// command (VkDrawIndirectCommand: vertexCount, instanceCount, firstVertex,
// firstInstance). Culled cells get instanceCount 0 — a GPU no-op — so the
// grass pass draws the whole ring in one submission and the half of the ring
// behind the camera stops costing vertex work.
//
// Binding contract (RHI::setComputeBuffer / setComputeBytes):
//   b0 = CameraData (frustumPlanes, same mirror as GpuCull.comp)
//   b1 = GrassCullInfoGpu[] (cell AABB + slot range; render_data.hpp)
//   b2 = draw args (uint4 per cell, written)
//   push (binding 4 -> offset 0) = { uint cellCount }

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Must match CameraRenderData (C++); same mirror as GpuCull.comp.
struct CameraData {
    mat4 proj;
    mat4 view;
    mat4 invProj;
    mat4 invView;
    float nearPlane;
    float farPlane;
    vec2 _pad;
    vec3 position;
    float _pad2;
    vec4 frustumPlanes[6];
};

// Must match Vapor::GrassCullInfoGpu (std430, 32 bytes).
struct GrassCullInfo {
    vec3 aabbMin;
    uint firstInstance;
    vec3 aabbMax;
    uint count;
};

layout(std430, binding = 0) readonly buffer CameraBuf { CameraData cam; };
layout(std430, binding = 1) readonly buffer CullInfoBuf { GrassCullInfo cells[]; };
layout(std430, binding = 2) writeonly buffer ArgsBuf { uint args[]; };

layout(push_constant) uniform Push {
    uint cellCount;
    uint pad0;
    uint pad1;
    uint pad2;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= cellCount) return;
    GrassCullInfo c = cells[i];

    // AABB vs frustum, positive-vertex test (planes point inward, same sign
    // convention as GpuCull.comp's sphere test): fully outside any plane =>
    // culled. Conservative — never culls a visible cell.
    bool visible = true;
    for (int p = 0; p < 6; ++p) {
        vec4 plane = cam.frustumPlanes[p];
        vec3 v = mix(c.aabbMin, c.aabbMax, greaterThan(plane.xyz, vec3(0.0)));
        if (dot(plane.xyz, v) + plane.w < 0.0) { visible = false; break; }
    }

    // 15 vertices per blade (two tapered quads + tip); baseInstance selects
    // the cell's slot range in the shared blade pool.
    args[i * 4u + 0u] = 15u;
    args[i * 4u + 1u] = visible ? c.count : 0u;
    args[i * 4u + 2u] = 0u;
    args[i * 4u + 3u] = c.firstInstance;
}
