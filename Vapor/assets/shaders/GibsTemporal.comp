#version 460
// GIBS surfel temporal smoothing — GLSL twin of gibs_temporal.metal's
// `surfelTemporalSmooth`: hysteresis decay of irradiance on surfels that were
// not refreshed this frame (handles no-longer-visible surfels).
#extension GL_GOOGLE_include_directive : require
#include "include/gibs_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer SurfelBuf { Surfel surfels[]; };
layout(std430, set = 0, binding = 1) readonly buffer GIBSBuf { GIBSData gibs; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= gibs.activeSurfelCount) {
        return;
    }

    Surfel surfel = surfels[gid];
    if ((surfel.flags & SURFEL_FLAG_VALID) == 0u) {
        return;
    }

    // Hysteresis: gradually reduce irradiance if not updated.
    if ((surfel.flags & SURFEL_FLAG_NEEDS_UPDATE) == 0u) {
        surfel.irradiance = surfel.irradiance * gibs.hysteresis;
    }

    surfels[gid] = surfel;
}
