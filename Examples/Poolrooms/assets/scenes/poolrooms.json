  "materials": [
    { "name": "deckTile",       "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@deckAlbedo", "normalMap": "@deckNormal", "roughnessMap": "@deckRough" },
    { "name": "wallTile",       "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@wallAlbedo", "normalMap": "@wallNormal", "roughnessMap": "@wallRough" },
    { "name": "poolWallTile",   "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@poolWallAlbedo", "normalMap": "@poolWallNormal", "roughnessMap": "@poolWallRough" },
    { "name": "poolFloorTile",  "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@poolFloorAlbedo", "normalMap": "@poolFloorNormal", "roughnessMap": "@poolFloorRough" },
    { "name": "accentTile",     "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@accentAlbedo", "normalMap": "@accentNormal", "roughnessMap": "@accentRough" },
    { "name": "groutMat",       "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@groutAlbedo", "normalMap": "@groutNormal", "roughnessMap": "@groutRough" },
    { "name": "copingMat",      "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@copingAlbedo", "normalMap": "@copingNormal", "roughnessMap": "@copingRough" },
    { "name": "ceilingPlaster", "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@plasterAlbedo", "normalMap": "@plasterNormal", "roughnessMap": "@plasterRough" },
    { "name": "darkPlaster",    "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@darkAlbedo", "normalMap": "@darkNormal", "roughnessMap": "@darkRough" },
    { "name": "metalMat",       "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 1.0, "useIBL": true,
      "albedoMap": "@metalAlbedo", "normalMap": "@metalNormal", "roughnessMap": "@metalRough" },

    { "_comment": "The glow discs are emissive geometry, so the lamps show up in the water's planar reflection (the mirror pass shades emissive) rather than only as point lights.",
      "name": "lampGlow",       "baseColorFactor": [1, 1, 1, 1], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "emissiveFactor": [1.0, 0.82, 0.55], "emissiveStrength": 3.5,
      "albedoMap": "@lampAlbedo", "normalMap": "@lampNormal", "roughnessMap": "@lampRough", "emissiveMap": "@lampEmissive" },

    { "_comment": "Slide shells: hue from the base colour, gloss from the roughness MAP (factor stays 1).",
      "name": "slideBlue",      "baseColorFactor": [0.16, 0.38, 0.88, 1.0], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@slideAlbedo", "normalMap": "@slideNormal", "roughnessMap": "@slideRough" },
    { "name": "slideViolet",    "baseColorFactor": [0.48, 0.26, 0.85, 1.0], "roughnessFactor": 1.0, "metallicFactor": 0.0, "useIBL": true,
      "albedoMap": "@slide2Albedo", "normalMap": "@slide2Normal", "roughnessMap": "@slide2Rough" }
  ],

  "entities": [
    {
      "_comment": "One entity for the whole hall. The generator returns a bucket per material slot, the static colliders its CSG implies, and the water / lamps / spawn / markers as children.",
      "name": "Hall",
      "procMesh": {
        "generator": "poolroom",
        "params": { "flooded": false },
        "materials": {
          "deck_tile": "deckTile",
          "wall_tile": "wallTile",
          "pool_wall_tile": "poolWallTile",
          "pool_floor_tile": "poolFloorTile",
          "accent_tile": "accentTile",
          "grout": "groutMat",
          "coping": "copingMat",
          "ceiling_plaster": "ceilingPlaster",
          "dark_plaster": "darkPlaster",
          "metal": "metalMat",
          "lamp_glow": "lampGlow",
          "slide_blue": "slideBlue",
          "slide_violet": "slideViolet"
        }
      }
    },
    {
      "_comment": "Steep late-morning sun, so the shafts from the skylight wells land on the water and the north deck.",
      "name": "Sun",
      "components": {
        "directionalLight": { "direction": [0.263776, -0.942056, 0.207252], "color": [1.0, 0.97, 0.90], "intensity": 8.0 },
        "sun": {}
      }
    },
    { "name": "Environment", "components": { "sky": {} } },
    {
      "_comment": "Humid haze over the water: a bounded fog bank hugging the hall.",
      "name": "Pool Haze",
      "position": [0.0, 1.6, 0.0],
      "components": {
        "volumetricFog": {
          "bounded": true,
          "halfExtent": [12.2, 3.2, 5.2],
          "edgeFalloff": 1.5,
          "density": 0.016,
          "albedo": [0.92, 0.96, 1.0],
          "anisotropy": 0.62,
          "ambientIntensity": 0.35
        }
      }
    }
  ]
